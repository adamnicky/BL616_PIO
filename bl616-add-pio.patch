diff --git a/examples/pio/pio_blink/main.c b/examples/pio/pio_blink/main.c
new file mode 100644
index 00000000..31560714
--- /dev/null
+++ b/examples/pio/pio_blink/main.c
@@ -0,0 +1,137 @@
+#include "bflb_mtimer.h"
+#include "bflb_irq.h"
+#include "board.h"
+#include "bl616_glb_gpio.h"
+#include "bl616_irq.h"
+#include "hardware/pio.h"
+#include "pio_blink.pio.h"
+
+#define USED_PIN 27
+
+#define SM0_RESET  (1u << 4)
+
+/* PEC clock = 160 MHz */
+#define PEC_CLK_HZ  160000000UL
+
+/* Desired blink frequency in Hz */
+#define BLINK_FREQ  1
+
+/* FIFO-based delay: loop takes X + 4 cycles per half-period with IRQ. */
+#define DELAY_COUNT ((PEC_CLK_HZ / (2 * BLINK_FREQ)) - 4)
+
+#define BLINK_IRQ_ON   0
+#define BLINK_IRQ_OFF  1
+
+static volatile uint32_t blink_on_irq_count;
+static volatile uint32_t blink_off_irq_count;
+static uint64_t blink_last_mtimer_us;
+
+#ifdef BL_IOT_SDK
+static void pio_blink_irq_handler(void *arg)
+{
+    (void)arg;
+#else
+static void pio_blink_irq_handler(int irq, void *arg)
+{
+    (void)irq;
+    (void)arg;
+#endif
+    bool on_irq = pio_interrupt_get(pio0, BLINK_IRQ_ON);
+    bool off_irq = pio_interrupt_get(pio0, BLINK_IRQ_OFF);
+
+    if (!on_irq && !off_irq) {
+        return;
+    }
+
+    if (on_irq) {
+        pio_interrupt_clear(pio0, BLINK_IRQ_ON);
+    }
+    if (off_irq) {
+        pio_interrupt_clear(pio0, BLINK_IRQ_OFF);
+    }
+
+    uint64_t mtimer_us = bflb_mtimer_get_time_us();
+    uint64_t delta_us = blink_last_mtimer_us == 0 ? 0 : mtimer_us - blink_last_mtimer_us;
+
+    blink_last_mtimer_us = mtimer_us;
+    if (on_irq) {
+        blink_on_irq_count++;
+        printf("blink on=%lu mtimer=%llu us delta=%llu us\r\n",
+               (unsigned long)blink_on_irq_count,
+               (unsigned long long)mtimer_us,
+               (unsigned long long)delta_us);
+    }
+    if (off_irq) {
+        blink_off_irq_count++;
+        printf("blink off=%lu mtimer=%llu us delta=%llu us\r\n",
+               (unsigned long)blink_off_irq_count,
+               (unsigned long long)mtimer_us,
+               (unsigned long long)delta_us);
+    }
+}
+
+int main(void) {
+    int rc;
+
+    board_init();
+
+    /* Enable PEC clock at 160 MHz */
+    pio_enable_pio_clk();
+
+    uint8_t pins[] = { USED_PIN };
+    GLB_GPIO_Func_Init(27, pins, 1);
+
+    /* Pin control: SET pin 27, count=1 */
+    pio0->sm[0].pinctrl = (USED_PIN << PIO_SM0_PINCTRL_SET_BASE_LSB) |
+                           (1u << PIO_SM0_PINCTRL_SET_COUNT_LSB);
+
+    /* CLKDIV = 1 (160 MHz, no division) */
+    pio0->sm[0].clkdiv = (1u << PIO_SM0_CLKDIV_INT_LSB);
+
+    /* No autopush/autopull, normal shift */
+    pio0->sm[0].shiftctrl = 0;
+
+    /* Wrap bottom=2, wrap top=9 */
+    pio0->sm[0].execctrl = (2u << PIO_SM0_EXECCTRL_WRAP_BOTTOM_LSB) |
+                            (9u << PIO_SM0_EXECCTRL_WRAP_TOP_LSB);
+
+    /* PIO program: FIFO-based delay blink
+     * 0: pull block           ; Pull delay count from TX FIFO (blocks if empty)
+     * 1: out y, 32            ; Shift all 32 bits into Y
+     * 2: mov x, y             ; X = delay count            [WRAP_TARGET]
+     * 3: set pins, 1          ; LED on
+     * 4: irq set 0            ; Signal LED-on transition
+     * 5: jmp x-- lp1          ; Delay loop: X + 1 cycles
+     * 6: mov x, y             ; X = delay count
+     * 7: set pins, 0          ; LED off
+     * 8: irq set 1            ; Signal LED-off transition
+     * 9: jmp x-- lp2          ; Delay loop: X + 1 cycles   [WRAP]
+     */
+    for (uint i = 0; i < pio_blink_program.length; ++i) {
+        pio0->instr_mem[i] = pio_blink_program.instructions[i];
+    }
+
+    /* Reset SM, then release reset and enable */
+    pio0->ctrl = SM0_RESET;
+    bflb_mtimer_delay_ms(1);
+
+    rc = bflb_irq_attach(BL616_IRQ_PIO0, pio_blink_irq_handler, NULL);
+    if (rc != 0) {
+        return rc;
+    }
+    pio_interrupt_clear(pio0, BLINK_IRQ_ON);
+    pio_interrupt_clear(pio0, BLINK_IRQ_OFF);
+    pio_set_irq0_source_enabled(pio0, pis_interrupt0, true);
+    pio_set_irq0_source_enabled(pio0, pis_interrupt1, true);
+    bflb_irq_enable(BL616_IRQ_PIO0);
+
+    pio0->ctrl = 1u;
+
+    /* Push delay count into TX FIFO before SM starts pulling */
+    pio0->txf[0] = DELAY_COUNT;
+
+    printf("Blinking pin %d at %d Hz (delay=%lu)...\r\n", USED_PIN, BLINK_FREQ, (unsigned long)DELAY_COUNT);
+    while (1) {
+        bflb_mtimer_delay_ms(500);
+    }
+}
diff --git a/examples/pio/pio_blink/pio_blink.pio b/examples/pio/pio_blink/pio_blink.pio
new file mode 100644
index 00000000..420c1ecb
--- /dev/null
+++ b/examples/pio/pio_blink/pio_blink.pio
@@ -0,0 +1,21 @@
+;
+; FIFO-configured delay blink.
+;
+.pio_version 0
+
+.program pio_blink
+
+    pull block
+    out y, 32
+.wrap_target
+    mov x, y
+    set pins, 1
+    irq set 0
+lp1:
+    jmp x-- lp1
+    mov x, y
+    set pins, 0
+    irq set 1
+lp2:
+    jmp x-- lp2
+.wrap
