diff --git a/cmake/pioasm.cmake b/cmake/pioasm.cmake
new file mode 100644
index 00000000..feceb0ba
--- /dev/null
+++ b/cmake/pioasm.cmake
@@ -0,0 +1,110 @@
+include_guard(GLOBAL)
+
+include(ExternalProject)
+
+set(BFLB_PIOASM_SOURCE_DIR "${BL_SDK_BASE}/tools/pioasm")
+set(BFLB_PIOASM_BINARY_DIR "${CMAKE_BINARY_DIR}/pioasm")
+set(BFLB_PIOASM_INSTALL_DIR "${CMAKE_BINARY_DIR}/pioasm-install")
+
+if(WIN32)
+    set(BFLB_PIOASM_EXECUTABLE
+        "${BFLB_PIOASM_INSTALL_DIR}/pioasm/pioasm.exe")
+else()
+    set(BFLB_PIOASM_EXECUTABLE
+        "${BFLB_PIOASM_INSTALL_DIR}/pioasm/pioasm")
+endif()
+
+find_package(BISON 3.4.2)
+find_package(FLEX 2.5.13)
+if(NOT BISON_FOUND OR NOT FLEX_FOUND)
+    message(FATAL_ERROR
+        "pioasm requires bison (>= 3.4.2) and flex (>= 2.5.13) to generate "
+        "parser/lexer sources at build time. Please install them and re-run cmake.")
+endif()
+
+function(bflb_init_pioasm)
+    if(NOT TARGET bflb_pioasm)
+        ExternalProject_Add(bflb_pioasm_build
+            PREFIX "${CMAKE_BINARY_DIR}/pioasm"
+            SOURCE_DIR "${BFLB_PIOASM_SOURCE_DIR}"
+            BINARY_DIR "${BFLB_PIOASM_BINARY_DIR}"
+            INSTALL_DIR "${BFLB_PIOASM_INSTALL_DIR}"
+            CMAKE_ARGS
+                "-DCMAKE_BUILD_TYPE=Release"
+                "-DCMAKE_INSTALL_PREFIX=${BFLB_PIOASM_INSTALL_DIR}"
+                "-DCMAKE_INSTALL_MESSAGE=NEVER"
+                "-DBISON_EXECUTABLE=${BISON_EXECUTABLE}"
+                "-DFLEX_EXECUTABLE=${FLEX_EXECUTABLE}"
+            BUILD_BYPRODUCTS "${BFLB_PIOASM_EXECUTABLE}"
+            EXCLUDE_FROM_ALL TRUE
+        )
+
+        add_executable(bflb_pioasm IMPORTED GLOBAL)
+        set_property(TARGET bflb_pioasm PROPERTY IMPORTED_LOCATION
+            "${BFLB_PIOASM_EXECUTABLE}")
+        add_dependencies(bflb_pioasm bflb_pioasm_build)
+    endif()
+endfunction()
+
+function(bflb_generate_pio_header TARGET)
+    set(one_value_args OUTPUT_DIR OUTPUT_FORMAT VERSION)
+    cmake_parse_arguments(BFLB_PIO "" "${one_value_args}" "" ${ARGN})
+
+    if(NOT BFLB_PIO_UNPARSED_ARGUMENTS)
+        message(FATAL_ERROR "bflb_generate_pio_header requires at least one .pio file")
+    endif()
+
+    bflb_init_pioasm()
+
+    if(BFLB_PIO_OUTPUT_FORMAT)
+        set(output_format "${BFLB_PIO_OUTPUT_FORMAT}")
+    else()
+        set(output_format "c-sdk")
+    endif()
+
+    if(BFLB_PIO_VERSION)
+        set(pio_version "${BFLB_PIO_VERSION}")
+    else()
+        set(pio_version "0")
+    endif()
+
+    if(BFLB_PIO_OUTPUT_DIR)
+        if(IS_ABSOLUTE "${BFLB_PIO_OUTPUT_DIR}")
+            set(header_dir "${BFLB_PIO_OUTPUT_DIR}")
+        else()
+            set(header_dir "${CMAKE_CURRENT_BINARY_DIR}/${BFLB_PIO_OUTPUT_DIR}")
+        endif()
+    else()
+        set(header_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
+    endif()
+    file(MAKE_DIRECTORY "${header_dir}")
+
+    foreach(pio_file IN LISTS BFLB_PIO_UNPARSED_ARGUMENTS)
+        if(IS_ABSOLUTE "${pio_file}")
+            set(pio_path "${pio_file}")
+        else()
+            set(pio_path "${CMAKE_CURRENT_SOURCE_DIR}/${pio_file}")
+        endif()
+        get_filename_component(pio_name "${pio_path}" NAME)
+        get_filename_component(pio_stem "${pio_path}" NAME_WE)
+        set(header "${header_dir}/${pio_name}.h")
+
+        string(MAKE_C_IDENTIFIER "${TARGET}_${pio_stem}_pio_h" header_target)
+        add_custom_command(
+            OUTPUT "${header}"
+            DEPENDS "${pio_path}" bflb_pioasm
+            COMMAND bflb_pioasm -o "${output_format}" -v "${pio_version}"
+                    "${pio_path}" "${header}"
+            COMMENT "Generating ${pio_name}.h with pioasm"
+            VERBATIM
+        )
+        add_custom_target("${header_target}" DEPENDS "${header}")
+        add_dependencies("${TARGET}" "${header_target}")
+        target_sources("${TARGET}" PRIVATE "${header}")
+        target_include_directories("${TARGET}" PRIVATE "${header_dir}")
+        target_compile_definitions("${TARGET}" PRIVATE
+            PICO_NO_HARDWARE=0
+            PICO_PIO_VERSION=0
+        )
+    endforeach()
+endfunction()
