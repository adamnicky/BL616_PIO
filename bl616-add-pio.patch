diff --git a/examples/pio/uart_rx/main.c b/examples/pio/uart_rx/main.c
new file mode 100644
index 00000000..9efac81d
--- /dev/null
+++ b/examples/pio/uart_rx/main.c
@@ -0,0 +1,110 @@
+#include "board.h"
+#include "bflb_irq.h"
+#include "bl616_glb_gpio.h"
+#include "bl616_irq.h"
+#include "hardware/pio.h"
+#include "uart_rx.pio.h"
+
+#define PIO_RX_PIN     27
+#define SERIAL_BAUD    115200U
+#define PIO_CLK_HZ     160000000
+
+static PIO uart_rx_pio;
+static uint uart_rx_sm;
+
+static void uart_rx_irq_process(void)
+{
+    while (!pio_sm_is_rx_fifo_empty(uart_rx_pio, uart_rx_sm)) {
+        putchar((int)(pio_sm_get(uart_rx_pio, uart_rx_sm) & 0xffu));
+    }
+}
+
+#ifdef BL_IOT_SDK
+static void uart_rx_irq_handler(void *arg)
+{
+    (void)arg;
+    uart_rx_irq_process();
+}
+#else
+static void uart_rx_irq_handler(int irq, void *arg)
+{
+    (void)irq;
+    (void)arg;
+    uart_rx_irq_process();
+}
+#endif
+
+static int uart_rx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baud)
+{
+    pio_sm_config config = uart_rx_program_get_default_config(offset);
+    int rc;
+
+    sm_config_set_in_pins(&config, pin);
+    sm_config_set_jmp_pin(&config, pin);
+    sm_config_set_in_shift(&config, true, false, 32);
+    sm_config_set_clkdiv(&config, (float)PIO_CLK_HZ / (8.0f * baud));
+
+    rc = pio_sm_init(pio, sm, offset, &config);
+    if (rc != PICO_OK) {
+        return rc;
+    }
+
+    return PICO_OK;
+}
+
+int main(void)
+{
+    PIO pio;
+    uint sm;
+    uint offset;
+    uint8_t pins[] = { PIO_RX_PIN };
+    int rc;
+
+    board_init();
+    pio_enable_pio_clk();
+
+    /* Route the selected GPIO to PIO; the state machine configures it as input. */
+    rc = GLB_GPIO_Func_Init(PIO_RX_PIN, pins, 1);
+    if (rc != 0) {
+        return rc;
+    }
+
+    if (!pio_claim_free_sm_and_add_program(&uart_rx_program, &pio, &sm, &offset)) {
+        printf("Unable to claim a PIO state machine\r\n");
+        return -1;
+    }
+
+    pio_sm_set_pindirs_with_mask(pio, sm, 0, 1u << PIO_RX_PIN);
+
+    rc = uart_rx_program_init(pio, sm, offset, PIO_RX_PIN, SERIAL_BAUD);
+    if (rc != PICO_OK) {
+        pio_remove_program_and_unclaim_sm(&uart_rx_program, pio, sm, offset);
+        return rc;
+    }
+
+    uart_rx_pio = pio;
+    uart_rx_sm = sm;
+
+    pio_interrupt_source_t rx_source = (pio_interrupt_source_t)(pis_sm0_rx_fifo_not_empty + sm);
+    int irq = sm < 2 ? BL616_IRQ_PIO0 : BL616_IRQ_PIO1;
+    uint irq_index = sm < 2 ? 0 : 1;
+
+    rc = bflb_irq_attach(irq, uart_rx_irq_handler, NULL);
+    if (rc != 0) {
+        pio_remove_program_and_unclaim_sm(&uart_rx_program, pio, sm, offset);
+        return rc;
+    }
+
+    if (irq_index == 0) {
+        pio_set_irq0_source_enabled(pio, rx_source, true);
+    } else {
+        pio_set_irq1_source_enabled(pio, rx_source, true);
+    }
+    bflb_irq_enable(irq);
+    pio_sm_set_enabled(pio, sm, true);
+
+    printf("PIO UART RX on GPIO %u at %u baud\r\n", PIO_RX_PIN, SERIAL_BAUD);
+    while (1) {
+        tight_loop_contents();
+    }
+}
diff --git a/examples/pio/uart_rx/uart_rx.pio b/examples/pio/uart_rx/uart_rx.pio
new file mode 100644
index 00000000..30b145cb
--- /dev/null
+++ b/examples/pio/uart_rx/uart_rx.pio
@@ -0,0 +1,22 @@
+;
+; 8N1 UART receiver with framing-error resynchronization.
+;
+.pio_version 0
+
+.program uart_rx
+
+start:
+    wait 0 pin 0
+    set x, 7 [10]
+bitloop:
+    in pins, 1
+    jmp x-- bitloop [6]
+    jmp pin good_stop
+
+    wait 1 pin 0
+    jmp start
+
+good_stop:
+    in null, 24
+    push block
+    jmp start
