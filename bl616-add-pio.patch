diff --git a/examples/pio/uart_tx/main.c b/examples/pio/uart_tx/main.c
new file mode 100644
index 00000000..f90d040a
--- /dev/null
+++ b/examples/pio/uart_tx/main.c
@@ -0,0 +1,74 @@
+#include "bflb_mtimer.h"
+#include "board.h"
+#include "bl616_glb_gpio.h"
+#include "hardware/pio.h"
+#include "uart_tx.pio.h"
+
+#define PIO_TX_PIN     27
+#define SERIAL_BAUD    115200U
+#define PIO_CLK_HZ     160000000
+
+static int uart_tx_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint baud)
+{
+    pio_sm_config config = uart_tx_program_get_default_config(offset);
+    int rc;
+
+    sm_config_set_out_shift(&config, true, false, 32);
+    sm_config_set_out_pins(&config, pin_tx, 1);
+    sm_config_set_sideset_pins(&config, pin_tx);
+    sm_config_set_clkdiv(&config, (float)PIO_CLK_HZ / (8.0f * baud));
+
+    rc = pio_sm_init(pio, sm, offset, &config);
+    if (rc != PICO_OK) {
+        return rc;
+    }
+
+    pio_sm_set_enabled(pio, sm, true);
+
+    return PICO_OK;
+}
+
+static void uart_tx_program_puts(PIO pio, uint sm, const char *text)
+{
+    while (*text != '\0') {
+        pio_sm_put_blocking(pio, sm, (uint32_t)(uint8_t)*text++);
+    }
+}
+
+int main(void)
+{
+    PIO pio;
+    uint sm;
+    uint offset;
+    uint8_t pins[] = { PIO_TX_PIN };
+    int rc;
+
+    board_init();
+    pio_enable_pio_clk();
+
+    /* Route the selected GPIO to PIO; the state machine drives its direction and value. */
+    rc = GLB_GPIO_Func_Init(PIO_TX_PIN, pins, 1);
+    if (rc != 0) {
+        return rc;
+    }
+
+    if (!pio_claim_free_sm_and_add_program(&uart_tx_program, &pio, &sm, &offset)) {
+        printf("Unable to claim a PIO state machine\r\n");
+        return -1;
+    }
+
+    pio_sm_set_pins_with_mask(pio, sm, 1u << PIO_TX_PIN, 1u << PIO_TX_PIN);
+    pio_sm_set_pindirs_with_mask(pio, sm, 1u << PIO_TX_PIN, 1u << PIO_TX_PIN);
+
+    rc = uart_tx_program_init(pio, sm, offset, PIO_TX_PIN, SERIAL_BAUD);
+    if (rc != PICO_OK) {
+        pio_remove_program_and_unclaim_sm(&uart_tx_program, pio, sm, offset);
+        return rc;
+    }
+
+    printf("PIO UART TX on GPIO %u at %u baud\r\n", PIO_TX_PIN, SERIAL_BAUD);
+    while (1) {
+        uart_tx_program_puts(pio, sm, "Hello, world! (from PIO)\r\n");
+        bflb_mtimer_delay_ms(1000);
+    }
+}
