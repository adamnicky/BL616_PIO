diff --git a/tools/pioasm/CMakeLists.txt b/tools/pioasm/CMakeLists.txt
new file mode 100644
index 00000000..277e4d6e
--- /dev/null
+++ b/tools/pioasm/CMakeLists.txt
@@ -0,0 +1,80 @@
+cmake_minimum_required(VERSION 3.15)
+project(bflb_pioasm CXX)
+
+if(NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release)
+endif()
+
+set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+find_package(BISON 3.4.2 REQUIRED)
+find_package(FLEX 2.5.13 REQUIRED)
+
+set(PIOASM_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/gen")
+
+add_custom_command(
+    OUTPUT
+        "${PIOASM_GEN_DIR}/parser.cpp"
+        "${PIOASM_GEN_DIR}/parser.hpp"
+        "${PIOASM_GEN_DIR}/location.h"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "${PIOASM_GEN_DIR}"
+    COMMAND ${BISON_EXECUTABLE} -Wcounterexamples
+            "--defines=${PIOASM_GEN_DIR}/parser.hpp"
+            "-o${PIOASM_GEN_DIR}/parser.cpp"
+            "${CMAKE_CURRENT_SOURCE_DIR}/parser.yy"
+    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/parser.yy"
+    COMMENT "Generating pioasm parser with bison"
+    VERBATIM
+)
+
+add_custom_command(
+    OUTPUT "${PIOASM_GEN_DIR}/lexer.cpp"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "${PIOASM_GEN_DIR}"
+    COMMAND ${FLEX_EXECUTABLE}
+            "-o${PIOASM_GEN_DIR}/lexer.cpp"
+            "${CMAKE_CURRENT_SOURCE_DIR}/lexer.ll"
+    DEPENDS
